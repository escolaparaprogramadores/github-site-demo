  "devDependencies": {
    "chai": "^4.5.0",
    "jsdom": "^19.0.0",
    "live-server": "^1.2.2",
    "mocha": "^9.2.2",
    "nyc": "^17.1.0",
    "parcel": "^2.16.4"
  }
}
