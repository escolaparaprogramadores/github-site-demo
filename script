using TechTalk.SpecFlow;
using $PROJECT_NAME.Context;
using $PROJECT_NAME.Infrastructure.Aws;
using Xunit;

namespace $PROJECT_NAME.Steps;

[Binding]
public class SampleSteps
{
    private readonly ScenarioContextData _context;
    private readonly ILambdaGateway _lambda;

    public SampleSteps(ScenarioContextData context, ILambdaGateway lambda)
    {
        _context = context;
        _lambda = lambda;
    }

    [Given("que envio um payload padrão")]
    public void GivenPayload()
    {
        _context.Payload = new { Id = Guid.NewGuid() };
    }

    [When("a lambda é executada")]
    public async Task WhenExecuta()
    {
        _context.Response = await _lambda.InvokeAsync(_context.Payload!);
    }

    [Then("deve retornar sucesso")]
    public void ThenValida()
    {
        Assert.NotNull(_context.Response);
    }
}
EOF

