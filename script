#!/bin/bash

DOMAIN=$1

if [ -z "$DOMAIN" ]; then
  echo "Uso: ./create-integrated-tests.sh NomeDoDominio"
  exit 1
fi

PROJECT_NAME="$DOMAIN.IntegratedTests"

echo "Criando projeto $PROJECT_NAME..."

